<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>UndeadOvertime.Core.CloudTests</AssemblyName>
    <LangVersion>9.0</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Core/UndeadOvertime.Core.Cloud.csproj" />
    <Compile Include="../../../Assets/UndeadOvertime/Tests/CoreEditMode/*.cs" />
    <Compile Include="Program.cs" />
    <PackageReference Include="NUnit" Version="[3.14.0]" />
    <PackageReference Include="NUnitLite" Version="[3.14.0]" />
  </ItemGroup>
</Project>
